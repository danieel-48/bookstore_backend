# ========================================================
# CONFIGURACIÓN DEL SERVIDOR
# ========================================================
PORT=8080

# ========================================================
# CONFIGURACIÓN DE BASE DE DATOS (NUBE O LOCAL)
# ========================================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bookstore
DB_USER=root
DB_PASSWORD=root
DB_SSL=false

# Opcional: URL completa de conexión (si se define, se usa directamente)
#DB_URL=jdbc:mysql://localhost:3306/bookstore?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# ========================================================
# CONFIGURACIÓN DEL FRONTEND (CORS)
# ========================================================
# Permite una o varias URLs separadas por coma
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
